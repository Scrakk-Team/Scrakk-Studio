              "queries/locals.scm",
              "queries/folds.scm",
              "queries/indents.scm"
            ],
            "abi": "tree-sitter-abi-14",
            "sha256": "949a92fb2be9f4619ad9da44011b4500b40f50366e7810552a341366f89ca727"
          }
        ]
      }
    ]
  }
