{
  "id": "scrakk.grammar.svelte",
  "name": "svelte (tree-sitter)",
  "version": "1.0.2",
  "author": "scrakk-grammar",
  "description": "Gramática tree-sitter de svelte compilada a wasm desde /home/julian/Documentos/Proyectos/InnertaEngine/InnertaEngine-Linux/deps/languages/tree-sitter-svelte",
