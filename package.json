{
  "name": "scrakk-studio",
  "version": "0.1.1",
  "description": "Scrakk Studio — IDE modular — React + TypeScript + Vite (hot reload) + Electron",
  "author": {
    "name": "Scrakk",
    "email": "founder@scrakk.art"
  },
  "homepage": "https://scrakk.art",
  "desktopName": "scrakk-studio.desktop",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node native/copy-node.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "up": "node tools/bump.mjs",
    "pack:audit": "node tools/pack-audit.mjs",
    "perf:baseline": "node tools/perf/baseline.mjs",
    "perf:baseline:runtime": "node tools/perf/baseline.mjs --runtime",
    "postinstall": "node node_modules/electron/install.js",
    "native:build": "napi build --platform --release --config native/search/napi.json --cwd native/search",
    "native:copy": "node native/copy-node.mjs",
    "desktop:install": "node tools/desktop/install.mjs",
    "sef": "node tools/sef/index.ts",
    "sef:create": "node tools/sef/index.ts create",
    "sef:build": "node tools/sef/index.ts build",
    "sef:pack": "node tools/sef/index.ts pack",
    "sef:validate": "node tools/sef/index.ts validate"
  },
  "dependencies": {
    "@proicons/react": "^4.13.7",
    "@supabase/supabase-js": "^2.116.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "node-pty": "^1.1.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver-types": "^3.18.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.0",
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
