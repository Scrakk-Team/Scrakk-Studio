{
  "name": "Scrakk Night",
  "type": "dark",
  "ansi": {
    "black": "#000000",
    "red": "#cd3131",
    "green": "#0dbc79",
    "yellow": "#e5e512",
    "blue": "#2472c8",
    "magenta": "#bc3fbc",
    "cyan": "#11a8cd",
    "white": "#e5e5e5",
    "brightBlack": "#666666",
    "brightRed": "#f14c4c",
    "brightGreen": "#23d18b",
    "brightYellow": "#f5f543",
    "brightBlue": "#3b8eea",
    "brightMagenta": "#d670d6",
    "brightCyan": "#29b8db",
    "brightWhite": "#ffffff"
  },
  "colors": {
    "bg": "#000000",
    "surface": "#101010",
    "surfaceRaised": "#161616",
    "border": "#262626",
    "borderStrong": "#3a3a3a",
    "accent": "#fb923c",
    "accentHover": "#f97316",
    "accentActive": "#ea580c",
    "onAccent": "#ffffff",
    "text": "#ffffff",
    "textSecondary": "#b8b8b8",
    "textMuted": "#7a7a7a",
    "error": "#e5484d",
    "errorHover": "#d13b40",
    "onError": "#ffffff",
    "warning": "#fbbf24",
    "success": "#34d399",
    "info": "#fb923c",
    "hover": "rgba(255, 255, 255, 0.07)",
    "active": "rgba(255, 255, 255, 0.12)",
    "scrollbarThumb": "rgba(255, 255, 255, 0.18)",
    "scrollbarThumbHover": "rgba(255, 255, 255, 0.35)",
    "indentGuide": "#262626",
    "panelBorder": "#262626",
    "panelBorderOpacity": 100,
    "editorBg": "#101010"
  },
  "components": {
    "tabs": {
      "activeBg": "#101010"
    },
    "editor": {
      "editorBg": "#101010"
    },
    "breadcrumb": {
      "breadcrumbBg": "#101010"
    },
    "welcomePage": {
      "welcomePageBg": "#101010",
      "welcomePageButtonBg": "#000000"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#7a7a7a",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#34d399"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#fbbf24"
    },
    {
      "scope": [
        "constant.language",
        "constant"
      ],
      "foreground": "#fbbf24"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "foreground": "#fb923c"
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#ea580c"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#b8b8b8"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "foreground": "#f97316"
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "foreground": "#ffd166"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#e5484d"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#f97316"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#ffffff"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#fbbf24"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#ffc078"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#b8b8b8"
    },
    {
      "scope": "markup.heading",
      "foreground": "#fb923c",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "fontStyle": "italic"
    }
  ]
}
