    "textMuted": "#8aa4b4",
    "error": "#e74c3c",
    "warning": "#f39c12",
    "success": "#27ae60",
    "info": "#3498db",
    "scrollbarThumb": "#b0c8d8",
    "scrollbarThumbHover": "#90a8b8",
    "indentGuide": "#d4e6f0",
    "surfaceRaised": "#e8f3fa",
    "hover": "#e9f4fb",
    "active": "#eaf4fb",
    "accentHover": "#1a85bd",
    "accentActive": "#2e8fc3",
    "errorHover": "#ea6153",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#cbdeeb",
    "editorBg": "#e6f2fa",
    "panelBorder": "#c4dae8"
