    {
      "scope": "storage.type",
      "foreground": "#9b59b6"
    },
    {
      "scope": "entity.name.function",
      "foreground": "#3498db"
    },
    {
      "scope": "entity.name.class",
      "foreground": "#f39c12"
    },
    {
      "scope": "variable",
      "foreground": "#2c3e50"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#e74c3c"
