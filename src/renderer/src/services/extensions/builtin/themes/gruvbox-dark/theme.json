    {
      "scope": "keyword.control",
      "foreground": "#fb4934"
    },
    {
      "scope": "storage.type",
      "foreground": "#fe8019"
    },
    {
      "scope": "entity.name.function",
      "foreground": "#b8bb26"
    },
    {
      "scope": "entity.name.class",
      "foreground": "#fabd2f"
    },
    {
      "scope": "entity.name.type",
      "foreground": "#fabd2f"
    },
    {
      "scope": "variable",
      "foreground": "#83a598"
    },
    {
      "scope": "support.function",
      "foreground": "#8ec07c"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#fb4934"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#fabd2f"
