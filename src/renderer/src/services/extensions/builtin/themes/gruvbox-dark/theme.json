    "success": "#b8bb26",
    "info": "#83a598",
    "scrollbarThumb": "#504945",
    "scrollbarThumbHover": "#665c54",
    "indentGuide": "#3c3836",
    "surfaceRaised": "#2b2d2e",
    "hover": "#383b3c",
    "active": "#464849",
    "accentHover": "#fe8d30",
    "accentActive": "#fe9742",
    "errorHover": "#fb5f4c",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#53504e",
