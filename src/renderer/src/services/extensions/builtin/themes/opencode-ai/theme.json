{
  "name": "OpenCode AI",
  "type": "dark",
  "radius": "rect",
  "colors": {
    "bg": "#0a0a0a",
    "surface": "#141414",
    "surfaceRaised": "#1e1e1e",
    "border": "#484848",
    "borderStrong": "#606060",
    "accent": "#fab283",
    "accentHover": "#ffc09f",
    "accentActive": "#f5a742",
    "onAccent": "#0a0a0a",
    "text": "#eeeeee",
    "textSecondary": "#808080",
    "textMuted": "#606060",
    "error": "#e06c75",
    "errorHover": "#e26a75",
    "onError": "#0a0a0a",
    "warning": "#f5a742",
    "success": "#7fd88f",
    "info": "#56b6c2",
    "hover": "#1e1e1e",
    "active": "#282828",
    "scrollbarThumb": "#3c3c3c",
    "scrollbarThumbHover": "#484848",
    "indentGuide": "#282828",
    "panelBorder": "#3c3c3c",
    "editorBg": "#0a0a0a",
    "titleBarBg": "#141414",
    "activityBarBg": "#141414",
    "statusBarBg": "#141414",
    "diffAdded": "rgba(79, 214, 190, 0.16)",
    "diffRemoved": "rgba(197, 59, 83, 0.18)",
    "diffModified": "rgba(157, 124, 216, 0.15)"
  },
  "components": {
    "tabs": {
      "activeBg": "#141414"
    },
    "editor": {
      "editorBg": "#0a0a0a"
    },
    "breadcrumb": {
      "breadcrumbBg": "#141414"
    }
  },
  "fonts": {
    "ui": {
      "family": "IBM Plex Mono",
      "source": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap",
      "size": "13px",
      "weight": "500",
      "lineHeight": "1.5"
    },
    "editor": {
      "family": "IBM Plex Mono",
      "source": "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap",
      "size": "13px",
      "lineHeight": "1.5"
    },
    "terminal": {
      "family": "IBM Plex Mono, monospace",
      "size": "13px"
    },
    "heading": {
      "family": "IBM Plex Mono",
      "weight": "700",
      "size": "16px"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#808080",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#7fd88f"
    },
    {
      "scope": [
        "constant.numeric",
        "number"
      ],
      "foreground": "#f5a742"
    },
    {
      "scope": [
        "constant.language",
        "constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "foreground": "#4fd6be"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other"
      ],
      "foreground": "#9d7cd8"
    },
    {
      "scope": [
        "keyword.operator",
        "operator"
      ],
      "foreground": "#56b6c2"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "function.name"
      ],
      "foreground": "#fab283"
    },
    {
      "scope": [
        "support.type",
        "entity.name.type",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#e5c07b"
    },
    {
      "scope": [
        "entity.name.class",
        "meta.class",
        "type.name"
      ],
      "foreground": "#ffc09f"
    },
    {
      "scope": [
        "entity.name.tag",
        "tag"
      ],
      "foreground": "#b8db87"
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "attribute"
      ],
      "foreground": "#8f8f8f"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#e06c75"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#e26a75"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#5c9cf5"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#828bb8"
    },
    {
      "scope": "markup.heading",
      "foreground": "#9d7cd8",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "foreground": "#f5a742",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "foreground": "#e5c07b",
      "fontStyle": "italic"
    }
  ]
}
