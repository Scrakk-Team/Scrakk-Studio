{
  "name": "Scrakk Day",
  "type": "light",
  "colors": {
    "bg": "#ffffff",
    "surface": "#e3e3e3",
    "surfaceRaised": "#f1f1f1",
    "border": "#c9c9c9",
    "borderStrong": "#969696",
    "accent": "#ea580c",
    "accentHover": "#c2410c",
    "accentActive": "#9a3412",
    "onAccent": "#ffffff",
    "text": "#0a0a0a",
    "textSecondary": "#555555",
    "textMuted": "#8f8f8f",
    "error": "#d92d20",
    "errorHover": "#b42318",
    "onError": "#ffffff",
    "warning": "#b45309",
    "success": "#15803d",
    "info": "#ea580c",
    "hover": "rgba(0, 0, 0, 0.07)",
    "active": "rgba(0, 0, 0, 0.12)",
    "scrollbarThumb": "rgba(0, 0, 0, 0.24)",
    "scrollbarThumbHover": "rgba(0, 0, 0, 0.4)",
    "indentGuide": "#cfcfcf",
    "panelBorder": "#c9c9c9",
    "panelBorderOpacity": 100,
    "editorBg": "#e3e3e3"
  },
  "components": {
    "tabs": {
      "activeBg": "#e3e3e3"
    },
    "editor": {
      "editorBg": "#e3e3e3"
    },
    "breadcrumb": {
      "breadcrumbBg": "#e3e3e3"
    },
    "welcomePage": {
      "welcomePageBg": "#e3e3e3",
      "welcomePageButtonBg": "#ffffff"
    }
  },
  "tokenColors": [
    { "scope": ["comment", "comment.line", "comment.block"], "foreground": "#8f8f8f", "fontStyle": "italic" },
    { "scope": ["string", "string.quoted", "string.template"], "foreground": "#c2410c" },
    { "scope": "constant.numeric", "foreground": "#ea580c" },
    { "scope": ["constant.language", "constant"], "foreground": "#c2410c" },
    { "scope": ["keyword", "keyword.control", "keyword.other", "storage.type", "storage.modifier"], "foreground": "#9a3412" },
    { "scope": "keyword.operator", "foreground": "#c2410c" },
    { "scope": ["entity.name.function", "support.function"], "foreground": "#b45309" },
    { "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"], "foreground": "#a16207" },
    { "scope": "entity.name.tag", "foreground": "#be185d" },
    { "scope": "entity.other.attribute-name", "foreground": "#be123c" },
    { "scope": ["variable", "variable.other"], "foreground": "#0a0a0a" },
    { "scope": "variable.parameter", "foreground": "#92400e" },
    { "scope": ["variable.object.property", "meta.object-literal.key", "support.type.property-name"], "foreground": "#b45309" },
    { "scope": ["punctuation", "punctuation.definition", "punctuation.separator"], "foreground": "#555555" },
    { "scope": "markup.heading", "foreground": "#ea580c", "fontStyle": "bold" },
    { "scope": "markup.bold", "fontStyle": "bold" },
    { "scope": "markup.italic", "fontStyle": "italic" }
  ]
}
