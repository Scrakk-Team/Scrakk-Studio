{
  "name": "Spotify Dark",
  "type": "dark",
  "colors": {
    "bg": "#121212",
    "surface": "#181818",
    "border": "#282828",
    "accent": "#1ed760",
    "text": "#ffffff",
    "textSecondary": "#b3b3b3",
    "textMuted": "#7c7c7c",
    "error": "#f3727f",
    "warning": "#ffa42b",
    "success": "#1ed760",
    "info": "#539df5",
    "scrollbarThumb": "#282828",
    "scrollbarThumbHover": "#3e3e3e",
    "indentGuide": "#1f1f1f",
    "surfaceRaised": "#262626",
    "hover": "#343434",
    "active": "#424242",
    "accentHover": "#34db70",
    "accentActive": "#46de7d",
    "errorHover": "#f4838e",
    "onAccent": "#000000",
    "onError": "#ffffff",
    "borderStrong": "#424242",
    "editorBg": "#181818",
    "panelBorder": "#282828"
  },
  "fonts": {
    "ui": {
      "family": "Plus Jakarta Sans",
      "source": "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap",
      "size": "13px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "editor": {
      "family": "JetBrains Mono",
      "source": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap",
      "size": "13px",
      "lineHeight": "1.5"
    },
    "terminal": {
      "family": "JetBrains Mono, monospace",
      "size": "12.5px"
    },
    "heading": {
      "family": "Plus Jakarta Sans",
      "weight": "700",
      "size": "15px"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#7c7c7c",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#1ed760"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#ffa42b"
    },
    {
      "scope": [
        "constant.language",
        "constant"
      ],
      "foreground": "#ffa42b"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#ffffff",
      "fontStyle": "bold"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#ffffff"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "foreground": "#539df5"
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "foreground": "#1ed760"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#1ed760"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#539df5"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#ffffff"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#b3b3b3"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#ffffff"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#b3b3b3"
    },
    {
      "scope": "markup.heading",
      "foreground": "#1ed760",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "fontStyle": "italic"
    }
  ]
}
