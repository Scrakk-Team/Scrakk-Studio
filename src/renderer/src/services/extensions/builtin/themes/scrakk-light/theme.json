{
  "name": "Scrakk Light",
  "type": "light",
  "colors": {
    "bg": "#ffffff",
    "surface": "#f7f8fa",
    "border": "#e0e0e0",
    "accent": "#7020F3",
    "text": "#333333",
    "textSecondary": "#666666",
    "textMuted": "#999999",
    "error": "#d32f2f",
    "warning": "#f57c00",
    "success": "#388e3c",
    "info": "#1976d2",
    "scrollbarThumb": "#c0c0c0",
    "scrollbarThumbHover": "#a0a0a0",
    "indentGuide": "#e0e0e0",
    "surfaceRaised": "#f7f8fa",
    "hover": "#f8f9fb",
    "active": "#f8f9fb",
    "accentHover": "#7e36f4",
    "accentActive": "#8a48f5",
    "errorHover": "#d84848",
    "onAccent": "#ffffff",
    "onError": "#ffffff",
    "borderStrong": "#e4e4e4",
    "editorBg": "#f7f8fa",
    "panelBorder": "#e0e0e0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "comment.line",
        "comment.block"
      ],
      "foreground": "#999999",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "foreground": "#388e3c"
    },
    {
      "scope": "constant.numeric",
      "foreground": "#f57c00"
    },
    {
      "scope": [
        "constant.language",
        "constant"
      ],
      "foreground": "#f57c00"
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "foreground": "#7020F3"
    },
    {
      "scope": "keyword.operator",
      "foreground": "#333333"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "foreground": "#1976d2"
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "foreground": "#f57c00"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#7020F3"
    },
    {
      "scope": "entity.other.attribute-name",
      "foreground": "#1976d2"
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "foreground": "#333333"
    },
    {
      "scope": "variable.parameter",
      "foreground": "#333333"
    },
    {
      "scope": [
        "variable.object.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "foreground": "#333333"
    },
    {
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator"
      ],
      "foreground": "#999999"
    },
    {
      "scope": "markup.heading",
      "foreground": "#7020F3",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.bold",
      "fontStyle": "bold"
    },
    {
      "scope": "markup.italic",
      "fontStyle": "italic"
    }
  ]
}
