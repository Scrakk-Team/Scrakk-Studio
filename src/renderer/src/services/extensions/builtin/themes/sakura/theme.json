    "textSecondary": "#f8bbd9",
    "textMuted": "#7a5a6a",
    "error": "#ff5252",
    "warning": "#ffab91",
    "success": "#80cbc4",
    "info": "#81d4fa",
    "scrollbarThumb": "#5a4a5d",
    "scrollbarThumbHover": "#6a5a6d",
    "indentGuide": "#4a3a4d",
    "surfaceRaised": "#463b49",
    "hover": "#524854",
    "active": "#5d5460",
    "accentHover": "#ffbecb",
    "accentActive": "#ffc4cf",
    "errorHover": "#ff6767",
    "onAccent": "#000000",
    "onError": "#ffffff",
    "borderStrong": "#6e6070",
