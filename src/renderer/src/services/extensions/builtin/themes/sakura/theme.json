    },
    {
      "scope": "entity.name.function",
      "foreground": "#81d4fa"
    },
    {
      "scope": "entity.name.class",
      "foreground": "#ffab91"
    },
    {
      "scope": "variable",
      "foreground": "#fce4ec"
    },
    {
      "scope": "entity.name.tag",
      "foreground": "#ff5252"
    },
    {
      "scope": "punctuation",
